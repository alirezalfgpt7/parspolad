{
  "name": "parspoolad-corporate-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"const {spawnSync,spawn}=require('node:child_process'),fs=require('node:fs');const php=spawnSync('php',['-v'],{stdio:'ignore'});const task=php.status===0&&fs.existsSync('vendor/autoload.php')?'dev:fullstack':'dev:frontend';const cli=process.env.npm_execpath;if(!cli)throw new Error('npm CLI path is unavailable');const c=spawn(process.execPath,[cli,'run',task],{stdio:'inherit',windowsHide:true});c.on('error',e=>{console.error(e);process.exitCode=1});c.on('exit',code=>{process.exitCode=code??1});\"",
    "dev:fullstack": "concurrently --kill-others --names frontend,backend \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite --host 0.0.0.0 --port 3000",
    "dev:backend": "php artisan serve --host=127.0.0.1 --port=8000",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.18",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-date-object": "^2.1.9",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.92.0",
    "react-multi-date-picker": "^4.5.2",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
