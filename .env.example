APP_NAME="پارس پولاد آقایی | Pars Poolad Aghaee"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
PORT=3000
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="پارس پولاد آقایی"

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parspoolad_portal
