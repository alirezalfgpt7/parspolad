# Application Environment Configuration
APP_NAME="Pars Poolad Aghaee"
APP_ENV=local
APP_URL="http://localhost:3000"
PORT=3000

# Frontend API Prefix (Vite)
VITE_API_BASE_URL="/api/v1"
VITE_APP_NAME="پارس پولاد آقایی"

# Security & Session
APP_KEY="base64:YOUR_APP_ENCRYPTION_KEY_HERE"
SESSION_SECRET="YOUR_SESSION_SECRET_HERE"
JWT_SECRET="YOUR_SANCTUM_TOKEN_SECRET_HERE"

# Initial Super Admin Bootstrap (used only on empty database first run)
SUPER_ADMIN_EMAIL="admin@parspooladaghaei.ir"
SUPER_ADMIN_PASSWORD="CHANGE_ME_ON_FIRST_LOGIN"

# Database (MySQL 8 / PostgreSQL for Laravel Backend)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parspolad
DB_USERNAME=root
DB_PASSWORD=

# Mail / SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@parspooladaghaei.ir"
MAIL_FROM_NAME="${APP_NAME}"

# SMS Providers (Kavenegar / SMS.ir / Melipayamak)
SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_SENDER_LINE=
